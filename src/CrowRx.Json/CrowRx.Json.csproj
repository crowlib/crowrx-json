<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>9</LangVersion>
		<Nullable>enable</Nullable>

		<!-- NuGet -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<VersionPrefix>2.0.1</VersionPrefix>

		<!-- Native 방지 -->
		<UseNativeCompilation>false</UseNativeCompilation>

		<RootNamespace>CrowRx.Json</RootNamespace>
		<AssemblyName>CrowRx.Json</AssemblyName>
		<PackageId>CrowRx.Json</PackageId>
		<ReferenceOutputAssembly>false</ReferenceOutputAssembly>

		<Title>CrowRx.Json</Title>
		<PackageTags>unity unity-editor</PackageTags>
		<Authors>newhory</Authors>
		<Description>Lightweight deterministic JSON serialization for .NET Standard 2.1 and Unity.</Description>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Version>$(VersionPrefix)</Version>
		<AssemblyTitle>CrowRx.Json</AssemblyTitle>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<None Include="LICENSE" Pack="true" PackagePath=""/>
		<None Include="README.md" Pack="true" PackagePath=""/>
		<None Include="API.md" Pack="true" PackagePath=""/>
		<None Include="MIGRATION_1X_TO_2X.md" Pack="true" PackagePath=""/>
		<None Include="SERIALIZATION_SPEC.md" Pack="true" PackagePath=""/>
		<None Include="BENCHMARK_RESULTS.md" Pack="true" PackagePath=""/>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="CrowRx.Json.Tests"/>
		<InternalsVisibleTo Include="CrowRx.Json.Benchmarks"/>
	</ItemGroup>

</Project>
